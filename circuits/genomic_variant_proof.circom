        5085526240764457041675730911863589584956131416959013383175138849515802036731,
        5112444338053033756179427338329056448203663669270517909342825022189163140490,
        21074556174009357158470116553996813435772748291623577554305382355021053279478,
        9404064968241382043696757407149240239715931951264581605797747209222864004070,
        2292344053232139940047363737399538649069754020861017678061021505381867414905,
        2299361837260263696517317712003736607918027047535692743094001114867271280618,
        11616546175857593547433685149184855244865754967032101603838022607223347585563,
        2510177595814713820386893412315690705263553142354592311782492165948396751653,
        6215454538290706039612304170245267958262996888533336003288640406066784108861,
        21376428975998984691711093320258811031548654262969899701279394304997013787418
    ];

    signal t2[ROUNDS];
    signal t4[ROUNDS];
    signal t6[ROUNDS];
    signal x[ROUNDS];

    x[0] <== witnessSecret + donorTraitBind;
    for (var i = 0; i < ROUNDS; i++) {
        var u = x[i] + witnessSecret + C[i];
        t2[i] <== u * u;
        t4[i] <== t2[i] * t2[i];
        t6[i] <== t4[i] * t2[i];
        if (i < ROUNDS - 1) {
            x[i + 1] <== t6[i] * u;
        } else {
            // Strict Miyaguchi-Preneel output equality (zero unconstrained slack variables)
            t6[i] * u === variantCommitment - donorTraitBind - witnessSecret;
        }
    }

    // 3. Quadratic domain-binding gate (binds bountyId, verifier, chainId, vkEpoch via IC[3])
    signal domainBind;
    domainBind <== domainHash * witnessSecret;
}

component main { public [ variantCommitment, donorTraitBind, domainHash ] } = GenomicVariantProof(91);
