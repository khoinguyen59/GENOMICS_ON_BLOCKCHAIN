# ===========================================================================
# GenoChain Protocol - Production & Testnet Environment Template
# ===========================================================================
# Copy to deploy/.env.production (git-ignored) and fill real values before deploying.
# NEVER commit real private keys, API tokens, swarm keys, or secrets into Git.

# --- 1. EVM Network & Deployment Credentials (Hardhat v3) ---
# Target network: baseSepolia (84532), sepolia (11155111), or base (8453)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_MAINNET_RPC_URL=
RPC_URL=https://sepolia.base.org

# Dedicated deployer EOA (funded ONLY with deployment gas; ownership transferred to GenomicTimelock)
DEPLOYER_PRIVATE_KEY=

# Dedicated low-privilege Capsule Dispatcher worker EOA (only required when using --profile custodial-dispatcher)
DISPATCHER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# --- 2. Production Hardening & Governance Flags (scripts/deploy/deploy.js) ---
SKIP_SEEDING=1
DISABLE_FAUCET=1
# Optional: keep faucet enabled ONLY with off-chain ECDSA vouchers (set DISABLE_FAUCET=0 and provide signer)
FAUCET_VOUCHER_SIGNER=
# Least-privilege role wiring under SKIP_SEEDING=1:
# Leave blank to avoid granting the deployer EOA runtime dispatcher or lab-attestor privileges.
# Set explicitly ONLY if enrolling a dedicated custodial dispatcher or certified clinical lab signer at deploy time.
CAPSULE_DISPATCHER_ADDRESS=
INITIAL_LAB_ATTESTOR=
ENABLE_TIMELOCK=1
# Minimum 172800s (48h) recommended for mainnet; 300s-3600s acceptable for staging testnet
TIMELOCK_DELAY_SEC=172800
# Comma-separated Gnosis Safe / multisig addresses (no zero address in proposers)
TIMELOCK_PROPOSERS=
TIMELOCK_EXECUTORS=
# Leave blank (defaults to 0x0000...0000) so GenomicTimelock is strictly self-administered
TIMELOCK_ADMIN=

# --- 3. Frontend Vite Build Configuration (Cloudflare Pages / Static Host) ---
VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532
VITE_CHAIN_NAME=Base Sepolia
# Point frontend to your Caddy HTTPS Private IPFS Gateway (never expose raw Kubo 5001/8080)
# Matches frontend/.env.example and ipfs/kubo_client.js (origin without trailing /ipfs)
VITE_KUBO_GATEWAY=https://ipfs.genochain.example.com
VITE_KUBO_RPC=

# --- 4. Oracle VPS Services (Private Kubo + Gated Gateway + Caddy + Optional Custodial Dispatcher) ---
# Generate with: python deploy/generate_swarm_key.py (git-ignored under deploy/secrets/swarm.key)
KUBO_SWARM_KEY_FILE=./secrets/swarm.key
GATEWAY_DOMAIN=ipfs.genochain.example.com
ACME_EMAIL=ops@genochain.example.com
CORS_ALLOWED_ORIGIN=https://genochain.example.com
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=8090
GDPR_POLL_SEC=30
KUBO_GC_TIMEOUT_SEC=180
GATEWAY_MAX_UPLOADS_PER_HOUR=60
GATEWAY_MAX_UPLOAD_BYTES_PER_HOUR=2147483648
GATEWAY_MAX_GLOBAL_UPLOAD_BYTES_PER_HOUR=10737418240
GATEWAY_MAX_TOTAL_PINNED_BYTES=53687091200
GATEWAY_UPLOAD_POLICY=onchain-eligible
GATEWAY_UPLOAD_ALLOWLIST=
GATEWAY_MIN_UPLOAD_WEI=1000000000000000
GATEWAY_MIN_UPLOAD_GENO=1000000000000000000
GATEWAY_ORPHAN_PIN_TTL_SEC=3600
# Optional runtime contract overrides (leave empty to read baked-in frontend/src/contracts/contractAddresses.json)
REGISTRY_ADDRESS=
DEPLOYED_BLOCK=

# Optional custodial dispatcher profile (--profile custodial-dispatcher)
# Mount a dedicated vault directory (NOT deploy/secrets root) so atomic rename hot-reload works without exposing swarm.key
DISPATCHER_VAULT_DIR=./secrets/vault
DISPATCHER_POLL_INTERVAL=6
MAX_ROTATIONS_PER_HOUR=20
DISPATCHER_HEALTH_PORT=8091

# Strong high-entropy passphrase (>=32 random chars) used with PBKDF2-HMAC-SHA256 (210,000 iters + random salt)
# Leave empty if using AWS KMS envelopes exclusively
GENOCHAIN_SEED_VAULT_SECRET=

# --- 5. Optional AWS KMS / S3 Backup Experiment (Leave blank for 100% self-hosted VPS) ---
# Set INSTALL_BOTO3_FLAG=boto3==1.35.99 before building Dockerfile.dispatcher when enabling AWS KMS
INSTALL_BOTO3_FLAG=
AWS_REGION=ap-southeast-1
AWS_KMS_KEY_ID=
AWS_S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=