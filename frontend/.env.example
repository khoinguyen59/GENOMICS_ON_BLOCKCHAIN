# GenoChain Frontend Environment Configuration (copy to .env.local for custom networks)
# Target EVM JSON-RPC endpoint (defaults to http://127.0.0.1:8545 ONLY when VITE_CHAIN_ID=31337)
VITE_RPC_URL=http://127.0.0.1:8545
# Target EVM Chain ID (default: 31337 for Local Hardhat; e.g., 84532 for Base Sepolia, 11155111 for Sepolia)
VITE_CHAIN_ID=31337
# Human-readable network label shown in MetaMask switch prompts
VITE_CHAIN_NAME=Hardhat Localhost (31337)

# IPFS Storage & Private SIWE Gateway Overrides
# For production VPS deployments, leave VITE_KUBO_RPC empty and point VITE_KUBO_GATEWAY to your Caddy HTTPS gateway.
VITE_KUBO_RPC=http://127.0.0.1:5001
VITE_KUBO_GATEWAY=http://127.0.0.1:8080

# SECURITY WARNING: Any VITE_* variable is compiled verbatim into the public browser JS bundle.
# NEVER put a production Pinata admin JWT into VITE_PINATA_JWT; use the SIWE-authenticated Private IPFS
# Gateway (VITE_KUBO_GATEWAY) or let operators enter a scoped short-lived JWT at runtime via IPFS Settings.
# VITE_PINATA_JWT=